# ExecStartPre of huginn-app (through runagent): write state/Procfile with the
# configured number of Delayed Job workers (see pypkg/huginnworker.py).

import huginnworker

huginnworker.write_procfile("Procfile", huginnworker.current()["delayed_job_workers"])
