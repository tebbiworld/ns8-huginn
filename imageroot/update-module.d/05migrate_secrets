# Up to 1.2.2 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600); the values do not change.

import modsecrets

modsecrets.migrate_from_env(
    ["APP_SECRET_TOKEN", "MARIADB_PASSWORD", "MARIADB_ROOT_PASSWORD", "SEED_PASSWORD",
     "INVITATION_CODE", "OPENAI_API_KEY", "SMTP_MANUAL_PASSWORD"],
    aliases={"DATABASE_PASSWORD": "MARIADB_PASSWORD"},
)
