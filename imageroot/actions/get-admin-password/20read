# The initial administrator password seeded on the first start, on explicit
# request of the settings page (get-configuration never returns secrets). It is
# only valid until the administrator changes it inside Huginn.

import json
import os
import sys

import modsecrets

json.dump({"admin_username": os.getenv("SEED_USERNAME", "admin"),
           "admin_password": modsecrets.get("SEED_PASSWORD")}, fp=sys.stdout)
