#
# Reject an unknown time zone before it reaches the container.
#
# The value is handed to Huginn twice: as TZ (glibc) and as TIMEZONE, which
# Rails feeds into config.time_zone / Time.zone. An unknown name makes
# ActiveSupport raise "ArgumentError: Invalid Timezone" while the scheduler
# starts, so the application would no longer come up. Validate against the IANA
# database shipped with the node instead.
#

import os
import sys
import json
import zoneinfo

import agent

agent.set_weight(os.path.basename(__file__), 0)  # validation step, no progress weight

data = json.load(sys.stdin)
timezone = (data.get("timezone") or "").strip()

# An empty field keeps the currently configured zone (see
# 10configure_environment_vars), so there is nothing to validate.
if timezone and timezone not in zoneinfo.available_timezones():
    agent.set_status("validation-failed")
    json.dump(
        [{"field": "timezone", "parameter": "timezone", "value": timezone,
          "error": "timezone_not_valid"}],
        fp=sys.stdout,
    )
    sys.exit(2)
