import sys
import json
import agent

data = json.load(sys.stdin)

host = data.get("host")
h2hs = data.get("http2https", True)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)

# Optional timezone override for Huginn
if data.get("timezone"):
    agent.set_env("TZ", data["timezone"])

# Security-sensitive Huginn feature switches (both default to off). Changing
# either one is picked up when 80start_services restarts the huginn pod.
#   ENABLE_INSECURE_AGENTS unlocks the ShellCommandAgent and LocalFileAgent,
#   which can run arbitrary commands / read-write local files -> only enable on
#   a trusted, single-tenant instance.
agent.set_env("ENABLE_INSECURE_AGENTS",
              "true" if data.get("enable_insecure_agents", False) else "false")
agent.set_env("ENABLE_SECOND_PRECISION_SCHEDULE",
              "true" if data.get("enable_second_precision_schedule", False) else "false")

# Registration: the invitation code required to sign up. Only overwrite it when a
# non-empty value is supplied, so clearing the field in the UI keeps the current
# code instead of accidentally falling back to an empty/guessable one.
invitation_code = (data.get("invitation_code") or "").strip()
if invitation_code:
    agent.set_env("INVITATION_CODE", invitation_code)

# Require users to confirm their e-mail address before they can log in. Needs a
# working mail relay (cluster smarthost or manual SMTP above).
agent.set_env("REQUIRE_CONFIRMED_EMAIL",
              "true" if data.get("require_confirmed_email", False) else "false")

# Global fallback credentials for the built-in OpenAI agents.
agent.set_env("OPENAI_API_KEY", data.get("openai_api_key") or "")
agent.set_env("OPENAI_BASE_URL", (data.get("openai_base_url") or "").strip())

# Optional manual SMTP relay. These values are only used by discover-smarthost
# as a fallback when the cluster does NOT provide a smarthost. An empty host
# disables the manual settings again.
smtp_host = (data.get("smtp_host") or "").strip()
agent.set_env("SMTP_MANUAL_HOST", smtp_host)
agent.set_env("SMTP_MANUAL_PORT", str(data.get("smtp_port") or 587))
agent.set_env("SMTP_MANUAL_USERNAME", data.get("smtp_username") or "")
agent.set_env("SMTP_MANUAL_PASSWORD", data.get("smtp_password") or "")
agent.set_env("SMTP_MANUAL_STARTTLS", "true" if data.get("smtp_starttls", True) else "false")
agent.set_env("SMTP_MANUAL_FROM", data.get("smtp_from") or "")
# Verify the relay's TLS certificate. Applies to both the manual relay and the
# cluster smarthost fallback (see discover-smarthost). Disable it for internal
# relays that present a certificate not valid for their address.
agent.set_env("SMTP_MANUAL_SSL_VERIFY", "true" if data.get("smtp_ssl_verify", True) else "false")

# Persist environment so the systemd units pick up the new values
agent.dump_env()
