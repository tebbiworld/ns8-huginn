# Background workers and health check: ranges and the mail address.

import json
import os
import sys

import agent
import huginnworker

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = [{"field": f, "parameter": f, "value": data.get(f), "error": e} for f, e in huginnworker.validate(data)]
if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
