# Generate the long-lived secrets into state/passwords.env (mode 0600): they
# must not be stored in state/environment, which NS8 mirrors to Redis.

import secrets

import modsecrets

generated = modsecrets.ensure({
    # APP_SECRET_TOKEN must be a long hex string for Rails cookie signing.
    "APP_SECRET_TOKEN": secrets.token_hex(64),
    "MARIADB_PASSWORD": secrets.token_hex(16),
    "MARIADB_ROOT_PASSWORD": secrets.token_hex(16),
    # Initial Huginn admin password, seeded on first start.
    "SEED_PASSWORD": secrets.token_urlsafe(12),
    # Code required to register a new account.
    "INVITATION_CODE": secrets.token_urlsafe(12),
})
# The Huginn container expects the same value as DATABASE_PASSWORD.
modsecrets.write({"DATABASE_PASSWORD": modsecrets.get("MARIADB_PASSWORD")})
